#!/usr/bin/env bash
set -Eeuo pipefail

# Resolve the real executable so installed symlinks and moved portable folders work.
readonly CX_ROOT="$(cd -- "$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")/.." && pwd -P)"
readonly CONFIG_DIRECTORY="${CX_CONFIG_DIR:-$CX_ROOT/config}"
readonly BUILD_DIRECTORY="$CX_ROOT/container"
readonly VERSION="$(cat "$CX_ROOT/VERSION")"
DOCKER_TERMINAL_ARGS=(-i)
if [[ -t 0 && -t 1 ]]; then DOCKER_TERMINAL_ARGS+=(-t); fi

readonly IMAGE="${CX_IMAGE:-local/codex-isolated:latest}"
HOST_CODEX_HOME="${CX_CODEX_HOME:-$HOME/.codex}"
readonly HOST_ENV_HOME="${CX_ENV_HOME:-$HOME/.local/share/cx/environments}"
readonly REQUESTED_ENV_NAME="${CX_ENV_NAME:-}"
readonly CONTAINER_MEMORY="${CX_MEMORY:-8g}"
readonly CONTAINER_CPUS="${CX_CPUS:-4}"
readonly CONTAINER_PIDS="${CX_PIDS:-1024}"

usage() {
    cat <<'EOF'
Usage:
  cx [--agent codex|claude --account NAME] [directory] [native CLI arguments...]
  cx accounts list [--agent codex|claude]
  cx accounts add --agent codex|claude --account NAME --auth subscription|api-key
  cx accounts default --agent codex|claude --account NAME
  cx accounts remove NAME [--agent codex|claude]
  cx sessions remove ID [--agent codex|claude]
  cx sessions select [PROJECT] [--agent codex|claude --account NAME]

Examples:
  cx .
  cx ~/projects/my-app
  cx . --add-dir ../shared --add-dir /path/to/data
  cx . --add-file /path/to/notes.md --add-file ../settings.json
  cx . --ssh delta --remote-dir /remote/project
  cx . --ssh delta --remote-dir /remote/project --ssh-mount
  cx . --model YOUR_MODEL
  cx . exec "Run the test suite and fix failures"
  cx accounts add --agent codex --account personal --auth subscription
  cx accounts remove personal
  cx sessions remove 01234567-89ab-cdef-0123-456789abcdef
  cx --agent codex --account personal --login
  cx --agent claude --account work . exec "Run the tests"
  cx --auth-status
  cx --logout
  cx --setup-slurm SSH_ALIAS --shared-dir /shared/path/cx [--job-id-pattern REGEX]
  cx --shell [--add-dir DIR ...] [--add-file FILE ...]
  cx test_connection
    Check both managed CLI profiles with a short provider probe each.
    This can consume usage. Returns 1 if either check fails.
  cx --build                 Build the image (cached layers allowed)
  cx --rebuild               Rebuild with fresh layers
  cx --doctor                Check local prerequisites and paths
  cx --version

Account selection:
  Interactive launches show a CLI/account picker unless both are explicit.
  Scripts require a complete pair or an automation default; native --profile
  stays a CLI option. Wrapper parsing stops at -- (use it for Claude --agent).
  cx consumes that first --; use -- -- to forward a native CLI separator.
  Login/status/logout apply only to the selected account. API-key profiles use
  Codex's native stdin login or Claude's hidden terminal prompt.
  Managed interactive resume opens Sessions for either CLI.
  Explicit IDs and --last use native resume; native account checks still apply.
  Histories are shared among accounts of the same CLI; credentials/settings
  remain private. Do not edit one conversation concurrently. Both CLIs use
  the shared SSH/MCP bridge. Rebuild the image after upgrading cx.

Codex configuration:
  -c, --enable, --disable, and --search are per-run overrides. Codex runs
  those sessions in embedded mode. For persistent settings, edit
  the selected profile's config.toml. Explicit CX_CODEX_HOME selects legacy mode.

Environment:
  SSH MCP tools are registered automatically; --no-ssh-mcp uses CLI tools only.
  SSH mode supports Codex and Claude through the same bridge and MCP adapter.
  Managed interactive local and SSH sessions require host Python 3.11+.
  SSH also uses host OpenSSH configuration, an interactive terminal, and a
  remote Bash shell. Sessions opens automatically on a normal managed SSH
  launch when Bash confirms readiness. Ctrl-] r opens SSH, Ctrl-] c hands
  control to the assistant, and Ctrl-] q exits CX.
  Every CX header offers Ctrl-] ?: Help Menu. Press Ctrl-], release, then ?.
  Esc closes help and restores the previous view, draft and menu state.
  Ctrl-] s opens Sessions in managed interactive local and SSH sessions.
  / searches; Tab and Left/Right change CLI/status/sort; Ctrl-O changes density.
  F2 shows/hides internal reviewer threads (hidden initially).
  Name sort and compact rows are initial defaults; metadata is right-aligned.
  Arrows/Page keys move; Enter switches immediately; r renames; d/Delete confirms
  deletion shared by all accounts of that CLI; Esc/q closes; f refreshes.
  Previous assistants stay alive; running rows restore their saved screen/draft.
  Busy SSH/authentication blocks switching. Ctrl-] q exits all saved assistants.
  SSH and the assistant use separate saved screens with a full-width top bar:
  green for SSH and blue for the assistant/Sessions. No tmux is required.
  --ssh-mount exposes --remote-dir at /workspace/remote read-only; --ssh-mount=rw
  allows writes. Mounting additionally requires host sshfs and fusermount3
  (or fusermount), and an absolute --remote-dir.

  CX_CONFIG_DIR    System config folder, default: package/config
  CX_CODEX_VERSION Codex npm version used by --build/--rebuild, default: latest
  CX_CLAUDE_VERSION Claude npm version used by builds, default: 2.1.323
  CX_DATA_HOME     Managed profiles/history, default: ~/.local/share/cx/data
                   Portable default: bundle/data
  CX_GH_TOKEN_FILE Readable host token file for gh in this assistant session.
  CX_IMAGE         Container image name
  CX_CODEX_HOME    Explicit legacy Codex home; bypasses managed accounts/history
  CX_ENV_HOME      Persistent environment storage, default: ~/.local/share/cx/environments
  CX_ENV_NAME      Named environment override for this session
  CX_MEMORY        Container memory limit, default: 8g
  CX_CPUS          Container CPU limit, default: 4
  CX_PIDS          Container process limit, default: 1024
  CX_SLURM_CONFIG  Host file for per-SSH-alias Slurm settings, default: ~/.config/cx/slurm-servers.json

Documentation:
  https://github.com/BenjaminHerrera/CX/wiki
  The package's docs/README.md is the offline handbook.

Workspace layout:
  Sessions start at /workspace, containing main/, cx-external/, and remote/.
  Your selected local project is mounted at /workspace/main. Extra local
  directories appear in /workspace/cx-external. The remote/ folder is empty
  unless --ssh-mount is enabled. Use cd main to work on the local project.

Workspace filtering:
  If the workspace contains .codexignore, each listed workspace-relative path
  is replaced by an empty, read-only mount in the container. Path names remain
  visible, but their host contents do not. The .codexignore file is also masked.
  Blank lines and lines beginning with # are ignored.

Additional directories:
  Repeat --add-dir DIR to expose other writable directories. Relative paths are
  resolved from the primary workspace. External directories appear beneath
  /workspace/cx-external using their directory names. Each may have .codexignore.
  --shell also accepts --add-dir, using the current directory as its workspace.

Additional files:
  Repeat --add-file FILE to expose existing regular files read/write without
  sharing their parent directory. Relative paths resolve from the primary
  workspace. External files appear in /workspace/cx-external using sanitized
  filenames; collisions get -2, -3, etc. Files inside the project stay under
  /workspace/main. --shell also accepts --add-file. Use in-place writes for
  individual file mounts; replacing or deleting the mountpoint is unsupported.

Persistent environments:
  Each primary workspace receives a private Micromamba root at /cx-env. Use
  cx-env to inspect or select named environments. Environments are created only
  when needed; CX_ENV_NAME temporarily overrides the persistent selection.
EOF
}

die() {
    printf 'cx: %s\n' "$*" >&2
    exit 1
}

source "$CX_ROOT/bin/cx-accounts.sh"

run_with_watch() {
    if command -v python3 >/dev/null && command -v ssh >/dev/null; then
        python3 -B "$CX_ROOT/bin/cx-watch-launch.py" docker "$@"
    else
        docker "$@"
    fi
}

require_docker() {
    command -v docker >/dev/null 2>&1 ||
        die "Docker is not installed or is not in PATH."

    docker info >/dev/null 2>&1 ||
        die "Docker is not running or your user cannot access it."
}

ensure_image() {
    docker image inspect "$IMAGE" >/dev/null 2>&1 ||
        die "Image '$IMAGE' does not exist. Run cx --build (portable: /path/to/cx/cx --build)."
}

ensure_codex_home() {
    mkdir -p "$HOST_CODEX_HOME"
    chmod 700 "$HOST_CODEX_HOME"

    [[ -d "$HOST_CODEX_HOME" ]] ||
        die "Codex home is not a directory: $HOST_CODEX_HOME"

    [[ -r "$HOST_CODEX_HOME" ]] ||
        die "Codex home is not readable: $HOST_CODEX_HOME"

    [[ -w "$HOST_CODEX_HOME" ]] ||
        die "Codex home is not writable: $HOST_CODEX_HOME"
}

canonical_directory() {
    local target="$1"

    [[ -d "$target" ]] || die "Not a directory: $target"

    (
        cd -- "$target"
        pwd -P
    )
}

valid_environment_name() {
    local name="$1"
    [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ && "$name" != "base" ]]
}

validate_environment_name() {
    local name="$1"
    valid_environment_name "$name" ||
        die "Invalid CX_ENV_NAME '$name'. Use 1-64 ASCII letters, digits, '.', '_', or '-'; 'base' is reserved."
}

ENVIRONMENT_DOCKER_ARGS=()
HOST_WORKSPACE_ENV=""

prepare_environment_mount() {
    local workspace="$1"
    local environment_home codex_home_path workspace_name workspace_hash metadata_file

    [[ -z "$REQUESTED_ENV_NAME" ]] || validate_environment_name "$REQUESTED_ENV_NAME"
    command -v sha256sum >/dev/null 2>&1 ||
        die "sha256sum is required to identify workspace environments."
    command -v realpath >/dev/null 2>&1 ||
        die "realpath is required to validate CX_ENV_HOME."

    environment_home="$(realpath -m -- "$HOST_ENV_HOME")"
    codex_home_path="$(canonical_directory "$HOST_CODEX_HOME")"

    [[ "$environment_home" != "/" ]] ||
        die "Refusing to use the host root for CX_ENV_HOME."
    [[ "$environment_home" != *,* ]] ||
        die "CX_ENV_HOME contains a comma, which Docker cannot mount safely: $environment_home"

    if [[ "$environment_home" == "$workspace" ||
          "$environment_home" == "$workspace/"* ||
          "$workspace" == "$environment_home/"* ]]; then
        die "CX_ENV_HOME cannot overlap the primary workspace: $environment_home"
    fi

    if [[ "$environment_home" == "$codex_home_path" ||
          "$environment_home" == "$codex_home_path/"* ||
          "$codex_home_path" == "$environment_home/"* ]]; then
        die "CX_ENV_HOME cannot overlap the Codex credential directory: $environment_home"
    fi

    local private_path
    for private_path in "$DATA_HOME/profiles" "$DATA_HOME/history" "$DATA_HOME/shell-home"; do
        private_path="$(realpath -m -- "$private_path")"
        if [[ "$environment_home" == "$private_path" || "$environment_home" == "$private_path/"* || "$private_path" == "$environment_home/"* ]]; then
            die "CX_ENV_HOME cannot overlap managed account/history storage."
        fi
    done

    mkdir -p -- "$environment_home"
    chmod 700 -- "$environment_home"
    environment_home="$(canonical_directory "$environment_home")"

    workspace_name="${workspace##*/}"
    workspace_name="$(printf '%s' "$workspace_name" | sed 's/[^[:alnum:]_.-]/_/g')"
    [[ -n "$workspace_name" && "$workspace_name" != "." && "$workspace_name" != ".." ]] ||
        workspace_name="workspace"
    workspace_hash="$(printf '%s' "$workspace" | sha256sum)"
    workspace_hash="${workspace_hash%% *}"

    HOST_WORKSPACE_ENV="${environment_home}/${workspace_name}-${workspace_hash:0:16}"
    mkdir -p -- "$HOST_WORKSPACE_ENV"
    chmod 700 -- "$HOST_WORKSPACE_ENV"

    metadata_file="${HOST_WORKSPACE_ENV}/workspace-path"
    if [[ ! -f "$metadata_file" ]] || [[ "$(<"$metadata_file")" != "$workspace" ]]; then
        printf '%s\n' "$workspace" >"$metadata_file"
        chmod 600 -- "$metadata_file"
    fi

    ENVIRONMENT_DOCKER_ARGS=(
        --mount "type=bind,src=${HOST_WORKSPACE_ENV},dst=/cx-env"
        --env MAMBA_ROOT_PREFIX=/cx-env
        --env CX_WATCH_STATE_HOME=/cx-env/.cx-state
    )
    if [[ -n "$REQUESTED_ENV_NAME" ]]; then
        ENVIRONMENT_DOCKER_ARGS+=(--env "CX_ENV_NAME=${REQUESTED_ENV_NAME}")
    fi
}

IGNORE_MOUNT_ARGS=()
CODEXIGNORE_PATHS=()
ADDITIONAL_MOUNT_ARGS=()
CODEX_ARGS=()
ADDED_HOST_PATHS=()
ADDED_CONTAINER_PATHS=()

read_codexignore() {
    local workspace="$1"
    local ignore_file="${workspace}/.codexignore"
    local relative line seen duplicate

    CODEXIGNORE_PATHS=()

    [[ -f "$ignore_file" ]] || return 0

    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%$'\r'}"
        [[ -n "$line" && "$line" != \#* ]] || continue

        relative="$line"
        while [[ "$relative" == ./* ]]; do
            relative="${relative#./}"
        done
        relative="${relative%/}"

        [[ -n "$relative" && "$relative" != "." ]] || continue

        if [[ "$relative" == /* || "$relative" == ".." || "$relative" == ../* || "$relative" == */../* || "$relative" == */.. ]]; then
            die "Invalid path in $ignore_file: $line"
        fi

        duplicate=false
        for seen in "${CODEXIGNORE_PATHS[@]}"; do
            if [[ "$relative" == "$seen" ]]; then
                duplicate=true
                break
            fi
        done
        [[ "$duplicate" == false ]] || continue

        CODEXIGNORE_PATHS+=("$relative")
    done <"$ignore_file"
}

collect_ignore_mounts() {
    local workspace="$1"
    local container_root="$2"
    local ignore_file="${workspace}/.codexignore"
    local relative target covered masked seen
    local -a paths_to_mask=()
    local -a masked_directories=()
    local -a masked_paths=()

    [[ -f "$ignore_file" ]] || return 0

    read_codexignore "$workspace"
    paths_to_mask=(".codexignore" "${CODEXIGNORE_PATHS[@]}")

    for relative in "${paths_to_mask[@]}"; do
        [[ -e "${workspace}/${relative}" || -L "${workspace}/${relative}" ]] || continue

        covered=false
        for seen in "${masked_paths[@]}"; do
            if [[ "$relative" == "$seen" ]]; then
                covered=true
                break
            fi
        done
        [[ "$covered" == false ]] || continue

        for masked in "${masked_directories[@]}"; do
            if [[ "$relative" == "$masked" || "$relative" == "$masked/"* ]]; then
                covered=true
                break
            fi
        done
        [[ "$covered" == false ]] || continue

        target="${container_root%/}/${relative}"
        [[ "$target" != *,* ]] ||
            die "An ignored path contains a comma, which Docker cannot mount safely: $relative"

        if [[ -d "${workspace}/${relative}" && ! -L "${workspace}/${relative}" ]]; then
            IGNORE_MOUNT_ARGS+=(
                --mount "type=tmpfs,dst=${target},tmpfs-mode=0555,readonly"
            )
            masked_directories+=("$relative")
        else
            IGNORE_MOUNT_ARGS+=(
                --mount "type=bind,src=/dev/null,dst=${target},readonly"
            )
        fi
        masked_paths+=("$relative")
    done
}

ADDITIONAL_CONTAINER_PATH=""

allocate_additional_target() {
    local host_path="$1" fallback="$2" base_name candidate suffix=2 seen collision
    base_name="${host_path##*/}"
    base_name="$(printf '%s' "$base_name" | sed 's/[^[:alnum:]_.-]/_/g')"
    [[ -n "$base_name" && "$base_name" != "." && "$base_name" != ".." ]] || base_name="$fallback"
    candidate="$base_name"
    while true; do
        collision=false
        ADDITIONAL_CONTAINER_PATH="/workspace/cx-external/${candidate}"
        for seen in "${ADDED_CONTAINER_PATHS[@]}"; do
            [[ "$ADDITIONAL_CONTAINER_PATH" != "$seen" ]] || { collision=true; break; }
        done
        [[ "$collision" == true ]] || break
        candidate="${base_name}-${suffix}"
        suffix=$((suffix + 1))
    done
}

register_additional_file() {
    local workspace="$1" requested="$2" host_path container_path codex_home_path seen
    [[ "$requested" == /* ]] || requested="${workspace}/${requested}"
    [[ -f "$requested" ]] || die "--add-file requires an existing regular file: $requested"
    host_path="$(realpath -e -- "$requested")"
    reject_private_overlap "$host_path" file
    [[ -r "$host_path" && -w "$host_path" ]] || die "--add-file requires a readable, writable file: $host_path"
    codex_home_path="$(canonical_directory "$HOST_CODEX_HOME")"
    [[ "$host_path" != "$codex_home_path/"* ]] || die "Refusing to expose a Codex credential file through --add-file: $host_path"
    for seen in "${ADDED_HOST_PATHS[@]}"; do
        [[ "$host_path" != "$seen" ]] || return 0
    done
    if [[ "$host_path" != "$workspace/"* ]]; then
        [[ "$host_path" != *,* ]] || die "An --add-file path contains a comma, which Docker cannot mount safely: $host_path"
        allocate_additional_target "$host_path" file
        container_path="$ADDITIONAL_CONTAINER_PATH"
        ADDITIONAL_MOUNT_ARGS+=(--mount "type=bind,src=${host_path},dst=${container_path}")
        ADDED_CONTAINER_PATHS+=("$container_path")
    fi
    # Files inside main are already present; retain existing .codexignore masks.
    # --add-dir is a Codex directory option, so never forward a file to it.
    ADDED_HOST_PATHS+=("$host_path")
}

register_additional_directory() {
    local workspace="$1"
    local requested="$2"
    local host_path container_path codex_home_path seen

    if [[ "$requested" == /* ]]; then
        host_path="$(canonical_directory "$requested")"
    else
        host_path="$(canonical_directory "${workspace}/${requested}")"
    fi

    [[ "$host_path" != "/" ]] ||
        die "Refusing to add the host root directory."
    reject_private_overlap "$host_path" directory

    codex_home_path="$(canonical_directory "$HOST_CODEX_HOME")"
    if [[ "$host_path" == "$codex_home_path" ||
          "$host_path" == "$codex_home_path/"* ||
          "$codex_home_path" == "$host_path/"* ]]; then
        die "Refusing to expose the Codex credential directory through --add-dir: $host_path"
    fi

    for seen in "${ADDED_HOST_PATHS[@]}"; do
        [[ "$host_path" != "$seen" ]] || return 0
    done

    if [[ "$host_path" == "$workspace" ]]; then
        container_path="/workspace/main"
    elif [[ "$host_path" == "$workspace/"* ]]; then
        container_path="/workspace/main/${host_path#"$workspace/"}"
    elif [[ "$workspace" == "$host_path/"* ]]; then
        die "An --add-dir path cannot contain the primary workspace: $host_path"
    else
        [[ "$host_path" != *,* ]] ||
            die "An --add-dir path contains a comma, which Docker cannot mount safely: $host_path"

        allocate_additional_target "$host_path" directory
        container_path="$ADDITIONAL_CONTAINER_PATH"

        ADDITIONAL_MOUNT_ARGS+=(
            --mount "type=bind,src=${host_path},dst=${container_path}"
        )
        collect_ignore_mounts "$host_path" "$container_path"
        ADDED_CONTAINER_PATHS+=("$container_path")
    fi

    ADDED_HOST_PATHS+=("$host_path")
    CODEX_ARGS+=(--add-dir "$container_path")
}

prepare_workspace_mounts() {
    local workspace="$1"
    local parse_options=true requested
    shift

    IGNORE_MOUNT_ARGS=()
    ADDITIONAL_MOUNT_ARGS=()
    CODEX_ARGS=()
    ADDED_HOST_PATHS=()
    ADDED_CONTAINER_PATHS=()

    collect_ignore_mounts "$workspace" /workspace/main

    while (($# > 0)); do
        if [[ "$parse_options" == true ]]; then
            case "$1" in
                --)
                    parse_options=false
                    CODEX_ARGS+=("$1")
                    shift
                    continue
                    ;;
                --add-file)
                    (($# > 1)) || die "--add-file requires a file."
                    register_additional_file "$workspace" "$2"
                    shift 2
                    continue
                    ;;
                --add-file=*)
                    requested="${1#--add-file=}"
                    [[ -n "$requested" ]] || die "--add-file requires a file."
                    register_additional_file "$workspace" "$requested"
                    shift
                    continue
                    ;;
                --add-dir)
                    (($# > 1)) || die "--add-dir requires a directory."
                    requested="$2"
                    register_additional_directory "$workspace" "$requested"
                    shift 2
                    continue
                    ;;
                --add-dir=*)
                    requested="${1#--add-dir=}"
                    [[ -n "$requested" ]] || die "--add-dir requires a directory."
                    register_additional_directory "$workspace" "$requested"
                    shift
                    continue
                    ;;
            esac
        fi

        CODEX_ARGS+=("$1")
        shift
    done
}

prepare_browser_exec() {
    # /workspace is now a mount browser, above the project's Git repository.
    # Preserve cx exec without making an unrelated Git repository at the parent.
    local index=0 argument existing
    while ((index < ${#CODEX_ARGS[@]})); do
        argument="${CODEX_ARGS[index]}"
        case "$argument" in
            -c|--config|--enable|--disable|-m|--model|-p|--profile|-s|--sandbox|-a|--ask-for-approval|-C|--cd|-i|--image|--local-provider|--remote|--remote-auth-token-env|--add-dir)
                index=$((index + 2)); continue ;;
            --) return ;;
            -*) index=$((index + 1)); continue ;;
            exec|e)
                for existing in "${CODEX_ARGS[@]:index+1}"; do
                    [[ "$existing" != -- ]] || break
                    [[ "$existing" != --skip-git-repo-check ]] || return 0
                done
                CODEX_ARGS=("${CODEX_ARGS[@]:0:index+1}" --skip-git-repo-check "${CODEX_ARGS[@]:index+1}")
                return ;;
            *) return ;;
        esac
    done
}

run_container() {
    local workspace="$1"
    shift

    local uid gid docker_status config_directory
    uid="$(id -u)"
    gid="$(id -g)"
    config_directory="$(canonical_directory "$CONFIG_DIRECTORY")"
    [[ -f "${config_directory}/config.toml" ]] ||
        die "Missing cx system configuration: ${config_directory}/config.toml"
    [[ "$config_directory" != *,* ]] ||
        die "The cx path contains a comma, which Docker cannot mount safely: $config_directory"

    local -a github_mount=()
    if [[ -n "${CX_GH_TOKEN_FILE:-}" ]]; then
        local token_file
        token_file="$(realpath -e -- "$CX_GH_TOKEN_FILE" 2>/dev/null)" ||
            die "CX_GH_TOKEN_FILE must point to an existing readable file."
        [[ -f "$token_file" && -r "$token_file" && "$token_file" != *,* && "$token_file" != *\"* ]] ||
            die "CX_GH_TOKEN_FILE must point to a readable regular file with no commas or quotes in its path."
        [[ "$(docker image inspect --format '{{index .Config.Labels "io.cx.github-token-file"}}' "$IMAGE")" == 1 ]] ||
            die "Image lacks GitHub CLI token-file support. Run cx --rebuild."
        github_mount=(--mount "type=bind,src=${token_file},dst=/cx-github-token,readonly")
    fi

    prepare_environment_mount "$workspace"
    prepare_workspace_mounts "$workspace" "$@"
    if [[ "$AGENT" == codex ]]; then prepare_browser_exec; fi
    if [[ "$AGENT" == claude && "$uid" == 0 ]]; then
        die "Claude permission bypass requires a non-root host UID."
    fi

    # --cx-shell performs the image's environment setup without adding a -c
    # override to Codex; the mounted system config supplies those instructions.
    local -a ssh_args=()
    if [[ "$AGENT" == claude ]]; then
        ssh_args+=(--tmpfs "/workspace/.claude:rw,nosuid,nodev,size=16m,mode=700,uid=${uid},gid=${gid}")
    fi
    if [[ -n "${CX_SSH_BRIDGE_DIR:-}" ]]; then
        if [[ "$AGENT" == claude ]]; then
            [[ "$(docker image inspect --format '{{index .Config.Labels "io.cx.ssh-agents"}}' "$IMAGE")" == 2 ]] || die "Image lacks Claude SSH support. Run cx --rebuild."
        fi
        if [[ "${CX_SSH_MCP:-1}" == 1 ]]; then
            docker run --rm --user "${uid}:${gid}" --network none --read-only \
                --cap-drop ALL --security-opt no-new-privileges=true \
                --mount "type=bind,src=${CX_ROOT}/container/cx-mcp-check.mjs,dst=/opt/cx-mcp-check.mjs,readonly" \
                --entrypoint node "$IMAGE" /opt/cx-mcp-check.mjs \
                || die "SSH MCP adapter startup check failed (see diagnostic above). Run cx --rebuild, or use --ssh HOST --no-ssh-mcp."
        fi
        ssh_args+=(--env "CX_SSH_INSTRUCTIONS=${CX_SSH_INSTRUCTIONS:-}" --env "CX_SSH_MCP=${CX_SSH_MCP:-1}" --mount "type=bind,src=${CX_SSH_BRIDGE_DIR},dst=/cx-ssh,readonly"
            --env CX_SSH_SOCKET=/cx-ssh/bridge.sock --env "CX_SSH_HOST=${CX_SSH_HOST}")
    fi
    if [[ -n "${CX_SSH_MOUNT_PATH:-}" ]]; then
        [[ -n "${CX_SSH_BRIDGE_DIR:-}" ]] || die "SSH filesystem mount requires an SSH bridge."
        [[ "$CX_SSH_MOUNT_PATH" != *,* ]] || die "SSH mount path contains a comma."
        [[ "${CX_SSH_MOUNT_MODE:-}" == ro || "${CX_SSH_MOUNT_MODE:-}" == rw ]] || die "Invalid SSH mount mode."
        local mount_option="type=bind,src=${CX_SSH_MOUNT_PATH},dst=/workspace/remote"
        [[ "$CX_SSH_MOUNT_MODE" != ro ]] || mount_option+=",readonly"
        ssh_args+=(--mount "$mount_option" --env CX_SSH_REMOTE_ROOT=/workspace/remote
            --env "CX_SSH_MOUNT_MODE=${CX_SSH_MOUNT_MODE}")
        CODEX_ARGS=(--add-dir /workspace/remote "${CODEX_ARGS[@]}")
    fi
    local writer_lease="" writer_directory
    if [[ "$AGENT" == claude && "$LEGACY_ACCOUNT" == false ]]; then
        writer_directory="$DATA_HOME/history/claude/cx-live"
        private_directory "$writer_directory"
        writer_lease="$(mktemp "$writer_directory/launcher.XXXXXXXX")"
        printf '{"pid":%s,"account":"%s"}\n' "$$" "$ACCOUNT" >"$writer_lease"
        if [[ -e "$DATA_HOME/history/claude/cx-delete-lock" || -L "$DATA_HOME/history/claude/cx-delete-lock" ]]; then
            rm -f -- "$writer_lease"
            die "Claude history deletion is in progress; retry launch after it completes."
        fi
    fi
    if run_with_watch run --rm "${DOCKER_TERMINAL_ARGS[@]}" \
        "${ssh_args[@]}" \
        "${github_mount[@]}" \
        --name "cx-$(date +%s)-$$" \
        --hostname codex-sandbox \
        --user "${uid}:${gid}" \
        --workdir /workspace \
        --mount "type=bind,src=${workspace},dst=/workspace/main" \
        "${ADDITIONAL_MOUNT_ARGS[@]}" \
        "${IGNORE_MOUNT_ARGS[@]}" \
        "${ENVIRONMENT_DOCKER_ARGS[@]}" \
        "${ACCOUNT_MOUNTS[@]}" \
        "${ACCOUNT_ENV[@]}" \
        --mount "type=bind,src=${config_directory},dst=/etc/codex,readonly" \
        --tmpfs "/tmp:rw,nosuid,nodev,noexec,size=1g,mode=1777" \
        --tmpfs "/home/codex:rw,nosuid,nodev,size=512m,mode=700,uid=${uid},gid=${gid}" \
        --read-only \
        --cap-drop ALL \
        --security-opt no-new-privileges=true \
        --pids-limit "$CONTAINER_PIDS" \
        --memory "$CONTAINER_MEMORY" \
        --cpus "$CONTAINER_CPUS" \
        --ulimit nofile=4096:4096 \
        --env HOME=/home/codex \
        --env CODEX_HOME=/codex-home \
        --env TERM="${TERM:-xterm-256color}" \
        --env COLORTERM \
        "$IMAGE" \
        --cx-session \
        "${CODEX_ARGS[@]}"; then
        docker_status=0
    else
        docker_status=$?
    fi

    # Leave a conservative marker after a forced/crashed launcher; clear only
    # after Docker has returned normally, including a native nonzero exit.
    [[ -z "$writer_lease" ]] || rm -f -- "$writer_lease"
    return "$docker_status"
}

run_codex_utility() {
    local uid gid
    uid="$(id -u)"
    gid="$(id -g)"

    docker run --rm "${DOCKER_TERMINAL_ARGS[@]}" \
        --user "${uid}:${gid}" \
        "${ACCOUNT_MOUNTS[@]}" \
        "${ACCOUNT_ENV[@]}" \
        --tmpfs "/tmp:rw,nosuid,nodev,noexec,size=256m,mode=1777" \
        --tmpfs "/home/codex:rw,nosuid,nodev,size=128m,mode=700,uid=${uid},gid=${gid}" \
        --read-only \
        --cap-drop ALL \
        --security-opt no-new-privileges=true \
        --env HOME=/home/codex \
        --env CODEX_HOME=/codex-home \
        --env TERM="${TERM:-xterm-256color}" \
        --env COLORTERM \
        "$IMAGE" \
        "$@"
}

test_connection() {
    (($# == 0)) || die "Usage: cx test_connection"
    check_data_home
    local cli entry uid gid result=0 account
    local -a default=() candidates=()
    uid="$(id -u)"
    gid="$(id -g)"
    if [[ -f "$DATA_HOME/automation-default" && ! -L "$DATA_HOME/automation-default" ]]; then
        mapfile -t default <"$DATA_HOME/automation-default"
    fi
    for cli in codex claude; do
        candidates=()
        if [[ ! -L "$DATA_HOME/profiles" && ! -L "$DATA_HOME/profiles/$cli" ]]; then
            for entry in "$DATA_HOME/profiles/$cli/"*; do
                [[ -f "$entry/auth-mode" && ! -L "$entry/auth-mode" && ! -L "$entry" ]] || continue
                valid_account "${entry##*/}" && candidates+=("${entry##*/}")
            done
        fi
        account=""
        if [[ "${#default[@]}" == 2 && "${default[0]}" == "$cli" ]]; then
            account="${default[1]}"
        elif [[ "${#candidates[@]}" == 1 ]]; then
            account="${candidates[0]}"
        fi
        if [[ -z "$account" ]]; then
            if [[ "${#candidates[@]}" == 0 ]]; then
                printf '%s: no managed profile; use cx accounts add.\n' "$cli"
            else
                printf '%s: multiple profiles; select one with cx accounts default.\n' "$cli"
            fi
            result=1
            continue
        fi
        printf 'Checking %s/%s...\n' "$cli" "$account"
        # Selection must not prompt, create directories or modify profile data.
        if ! (
            unset CX_CODEX_HOME
            AGENT="$cli" ACCOUNT="$account"
            [[ ! -L "$DATA_HOME/profiles" && ! -L "$DATA_HOME/profiles/$cli" ]] ||
                die "Refusing symlinked account storage."
            select_account </dev/null
            [[ -d "$HOST_CODEX_HOME" && ! -L "$HOST_CODEX_HOME" && "$HOST_CODEX_HOME" != *,* && "$HOST_CODEX_HOME" != *\"* ]] ||
                die "Profile home is missing or invalid. Sign in with cx --login first."
            docker run --rm --init --user "$uid:$gid" --read-only --cap-drop ALL \
                --security-opt no-new-privileges=true --network bridge \
                --mount "type=bind,src=$HOST_CODEX_HOME,dst=/cx-probe-profile,readonly" \
                --mount "type=bind,src=$CX_ROOT/container/cx-connection,dst=/cx-connection,readonly" \
                --tmpfs /tmp:rw,nosuid,nodev,noexec,size=128m,mode=1777 \
                --workdir /tmp --env "CX_AGENT=$cli" --env "CX_AUTH_MODE=$ACCOUNT_AUTH" \
                --entrypoint /bin/bash "$IMAGE" /cx-connection
        ); then
            printf '%s/%s: connection check failed.\n' "$cli" "$account"
            result=1
        fi
    done
    return "$result"
}

run_shell() {
    local workspace="$1"
    shift
    local uid gid
    uid="$(id -u)"
    gid="$(id -g)"

    IGNORE_MOUNT_ARGS=()
    ADDITIONAL_MOUNT_ARGS=()
    CODEX_ARGS=()
    ADDED_HOST_PATHS=()
    ADDED_CONTAINER_PATHS=()
    validate_workspace "$workspace"
    collect_ignore_mounts "$workspace" /workspace/main
    prepare_environment_mount "$workspace"

    local requested
    while (($# > 0)); do
        case "$1" in
            --add-file)
                (($# > 1)) || die "--add-file requires a file."
                register_additional_file "$workspace" "$2"
                shift 2
                ;;
            --add-file=*)
                requested="${1#--add-file=}"
                [[ -n "$requested" ]] || die "--add-file requires a file."
                register_additional_file "$workspace" "$requested"
                shift
                ;;
            --add-dir)
                (($# > 1)) || die "--add-dir requires a directory."
                requested="$2"
                register_additional_directory "$workspace" "$requested"
                shift 2
                ;;
            --add-dir=*)
                requested="${1#--add-dir=}"
                [[ -n "$requested" ]] || die "--add-dir requires a directory."
                register_additional_directory "$workspace" "$requested"
                shift
                ;;
            *)
                die "Unsupported argument with --shell: $1"
                ;;
        esac
    done

    local docker_status
    if run_with_watch run --rm "${DOCKER_TERMINAL_ARGS[@]}" \
        --user "${uid}:${gid}" \
        --workdir /workspace \
        --mount "type=bind,src=${workspace},dst=/workspace/main" \
        "${ADDITIONAL_MOUNT_ARGS[@]}" \
        "${IGNORE_MOUNT_ARGS[@]}" \
        "${ENVIRONMENT_DOCKER_ARGS[@]}" \
        --mount "type=bind,src=${HOST_CODEX_HOME},dst=/codex-home" \
        --tmpfs "/tmp:rw,nosuid,nodev,size=256m,mode=1777" \
        --tmpfs "/home/codex:rw,nosuid,nodev,size=128m,mode=700,uid=${uid},gid=${gid}" \
        --read-only \
        --cap-drop ALL \
        --security-opt no-new-privileges=true \
        --env HOME=/home/codex \
        --env CODEX_HOME=/codex-home \
        --env TERM="${TERM:-xterm-256color}" \
        --env COLORTERM \
        "$IMAGE" \
        --cx-shell; then
        docker_status=0
    else
        docker_status=$?
    fi

    return "$docker_status"
}

validate_workspace() {
    local workspace="$1" codex_home_path
    reject_private_overlap "$workspace" directory
    codex_home_path="$(canonical_directory "$HOST_CODEX_HOME")"
    [[ "$workspace" != "/" ]] || die "Refusing to expose the host root directory."
    if [[ "$workspace" == "$codex_home_path" ||
          "$workspace" == "$codex_home_path/"* ||
          "$codex_home_path" == "$workspace/"* ]]; then
        die "The workspace cannot overlap the Codex credential directory: $workspace"
    fi
    [[ "$workspace" != *,* && "$codex_home_path" != *,* ]] ||
        die "Workspace and Codex home paths cannot contain commas."
}

build_image() {
    local -a build_args=(--pull)
    [[ "${1:-}" != "fresh" ]] || build_args+=(--no-cache)
    docker build "${build_args[@]}" \
        --build-arg "CODEX_VERSION=${CX_CODEX_VERSION:-latest}" \
        --build-arg "CLAUDE_VERSION=${CX_CLAUDE_VERSION:-2.1.323}" \
        -t "$IMAGE" "$BUILD_DIRECTORY"
    docker run --rm "$IMAGE" --version
    docker run --rm --entrypoint claude "$IMAGE" --version
    docker run --rm --entrypoint bwrap "$IMAGE" --version
    printf 'cx: built %s\n' "$IMAGE"
}

doctor() {
    local failed=0 tool
    printf 'cx %s\nPackage: %s\nConfig: %s\nImage: %s\nCodex home: %s\nEnvironments: %s\n' \
        "$VERSION" "$CX_ROOT" "$CONFIG_DIRECTORY" "$IMAGE" "$HOST_CODEX_HOME" "$HOST_ENV_HOME"
    for tool in docker realpath sha256sum sed; do
        if command -v "$tool" >/dev/null 2>&1; then
            printf 'OK: %s\n' "$tool"
        else
            printf 'MISSING: %s\n' "$tool"
            failed=1
        fi
    done
    if [[ -f "$CONFIG_DIRECTORY/config.toml" ]]; then
        printf 'OK: system config\n'
    else
        printf 'MISSING: system config\n'; failed=1
    fi
    if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
        printf 'OK: Docker daemon reachable (use a local daemon)\n'
        if docker image inspect "$IMAGE" >/dev/null 2>&1; then
            printf 'OK: image exists\n'
        else
            printf 'MISSING: image; run cx --build (portable: ./cx --build)\n'; failed=1
        fi
    else
        printf 'MISSING: Docker daemon access\n'; failed=1
    fi
    return "$failed"
}

sessions_command() {
    if [[ "${1:-}" == select ]]; then
        shift
        [[ -t 0 && -t 1 ]] || die "Session selection requires an interactive terminal."
        [[ -z "${CX_CODEX_HOME:-}" ]] || die "Session menu supports managed history only; unset CX_CODEX_HOME."
        exec env CX_SESSION_OPEN=1 "$CX_ROOT/bin/cx" "$@"
    fi
    local action="${1:-}" session_id=""
    [[ "$action" == remove || "$action" == menu-backend ]] || die "Usage: cx sessions select [PROJECT] [--agent CLI --account NAME] | cx sessions remove ID [--agent CLI]"
    shift
    account_options "$@"
    local cli directory destination found=false
    if [[ "$action" == remove ]]; then
        ((${#SELECTION_ARGS[@]} == 1)) && [[ -z "$ACCOUNT" ]] || die "Usage: cx sessions remove ID [--agent codex|claude]"
        session_id="${SELECTION_ARGS[0]}"
        [[ "$session_id" =~ ^[[:xdigit:]]{8}-[[:xdigit:]]{4}-[[:xdigit:]]{4}-[[:xdigit:]]{4}-[[:xdigit:]]{12}$ ]] || die "Use the full session UUID."
    else
        (($# == 0)) || die "Unexpected menu backend arguments."
    fi
    [[ -z "${CX_CODEX_HOME:-}" ]] || die "Session removal supports managed history only. Unset CX_CODEX_HOME first."
    check_data_home
    [[ ! -L "$DATA_HOME/history" ]] || die "Refusing symlinked history storage."
    local -a history_mounts=() history_env=()
    for cli in codex claude; do
        [[ -z "$AGENT" || "$AGENT" == "$cli" ]] || continue
        directory="$DATA_HOME/history/$cli"
        [[ ! -L "$directory" ]] || die "Refusing symlinked history storage: $cli"
        [[ ! -e "$directory" || -d "$directory" ]] || die "Invalid history storage: $cli"
        [[ -d "$directory" ]] || continue
        destination=/cx-history
        [[ "$cli" != claude ]] || destination=/cx-claude-history
        history_mounts+=(--mount "type=bind,src=$directory,dst=$destination")
        history_env+=(--env "CX_SESSION_${cli^^}_HISTORY=$destination")
        found=true
    done
    [[ "$found" == true ]] || die "No managed session history found."
    require_docker
    ensure_image
    local -a selection=()
    [[ -z "$AGENT" ]] || selection=(--agent "$AGENT")
    local -a utility_args=() utility_terminal=()
    if [[ "$action" == menu-backend ]]; then
        utility_terminal=(-i)
        utility_args=(/opt/cx-session-tools/cx-session-menu.mjs)
    else
        utility_args=(/opt/cx-session-tools/cx-sessions.mjs remove "$session_id" "${selection[@]}")
    fi
    docker run --rm "${utility_terminal[@]}" --user "$(id -u):$(id -g)" \
        --network none --read-only --cap-drop ALL --security-opt no-new-privileges=true \
        --tmpfs "/tmp:rw,nosuid,nodev,noexec,size=128m,mode=1777" \
        --tmpfs "/codex-home:rw,nosuid,nodev,size=16m,mode=700,uid=$(id -u),gid=$(id -g)" \
        "${history_mounts[@]}" "${history_env[@]}" \
        --mount "type=bind,src=$CX_ROOT/container/cx-sessions.mjs,dst=/opt/cx-session-tools/cx-sessions.mjs,readonly" \
        --mount "type=bind,src=$CX_ROOT/container/cx-codex-resume.mjs,dst=/opt/cx-session-tools/cx-codex-resume.mjs,readonly" \
        --mount "type=bind,src=$CX_ROOT/container/cx-session-menu.mjs,dst=/opt/cx-session-tools/cx-session-menu.mjs,readonly" \
        --env HOME=/tmp/cx-home --env CODEX_HOME=/codex-home --env CX_SESSION_CODEX_HOME=/codex-home --env CODEX_SQLITE_HOME=/cx-history/sqlite \
        --entrypoint node "$IMAGE" "${utility_args[@]}"
}

interactive_session() {
    local escaped=false command_position=true
    while (($#)); do
        case "$1" in
            --)
                if [[ "$escaped" == true ]]; then return 0; fi
                [[ "$AGENT" != claude ]] || command_position=false
                escaped=true; shift; continue ;;
            --help|-h|--version|-V|--print) return 1 ;;
            -p)
                [[ "$AGENT" != claude ]] || return 1
                shift; (($# == 0)) || shift; continue ;;
            --resume|-r)
                shift
                if (($#)) && [[ "$1" != -* ]]; then shift; fi
                continue ;;
            --model|-m|-c|--config|--profile|--enable|--disable|-C|--cd|--name|-n|--agents|--agent|--settings|--setting-sources|--permission-mode|--mcp-config|--add-dir|--add-file|--append-system-prompt|--system-prompt|--effort|--session-id)
                shift; (($# == 0)) || shift; continue ;;
            exec|e) [[ "$command_position" == false ]] || return 1 ;;
            -*) ;;
            *) command_position=false ;;
        esac
        shift
    done
    return 0
}

main() {
    umask 077
    if [[ "${1:-}" == accounts ]]; then shift; accounts_command "$@"; return; fi
    if [[ "${1:-}" == sessions ]]; then shift; sessions_command "$@"; return; fi
    account_options "$@"
    set -- "${SELECTION_ARGS[@]}"
    case "${1:-}" in
        -h|--help) usage; return ;;
        --version) printf 'cx %s\n' "$VERSION"; return ;;
        --doctor) doctor; return ;;
        --setup-slurm)
            shift
            command -v python3 >/dev/null || die "Slurm setup requires Python 3 on the host."
            command -v ssh >/dev/null || die "Slurm setup requires OpenSSH on the host."
            python3 "$CX_ROOT/bin/cx-slurm-setup.py" "$@"
            return ;;
    esac
    require_docker
    case "${1:-}" in
        --build) build_image; return ;;
        --rebuild) build_image fresh; return ;;
    esac
    ensure_image
    if [[ "${1:-}" == test_connection ]]; then
        [[ -z "$AGENT" && -z "$ACCOUNT" ]] || die "cx test_connection checks both CLIs using managed defaults."
        shift
        test_connection "$@"
        return
    fi
    if [[ "${1:-}" != --shell ]]; then
        select_account
        [[ "$LEGACY_ACCOUNT" == true ]] || private_directory "$HOST_CODEX_HOME"
        ensure_codex_home
        prepare_account_mounts
        local image_protocol
        image_protocol="$(docker image inspect --format '{{index .Config.Labels "io.cx.accounts"}}' "$IMAGE")"
        [[ "$image_protocol" == 1 ]] || die "Image lacks account/Claude support. Run cx --rebuild."
    else
        # Shells need no account selection and expose no managed credentials.
        check_data_home
        HOST_CODEX_HOME="${CX_CODEX_HOME:-$DATA_HOME/shell-home}"
        ensure_codex_home
    fi
    case "${1:-}" in
        --login|--auth-status|--logout)
            (($# == 1)) || die "Authentication actions accept selection options only."
            local action="${1#--}"
            [[ "$action" != auth-status ]] || action=status
            run_codex_utility --cx-auth "$action"; return ;;
        --shell)
            local shell_workspace
            shell_workspace="$(canonical_directory ".")"
            shift
            run_shell "$shell_workspace" "$@"
            return
            ;;
    esac
    local target="."
    if [[ $# -gt 0 && -d "$1" ]]; then target="$1"; shift; fi
    local workspace
    workspace="$(canonical_directory "$target")"
    validate_workspace "$workspace"
    local ssh_host="" remote_dir="" saw_ssh=false saw_dir=false parse_remote=true mount_mode="" ssh_mcp=1
    local -a forwarded=()
    while (($#)); do
        if [[ "$parse_remote" == true ]]; then
            case "$1" in
                --no-ssh-mcp) ssh_mcp=0; shift; continue ;;
                --) parse_remote=false ;;
                --ssh-mount|--ssh-mount=*)
                    [[ -z "$mount_mode" ]] || die "--ssh-mount may only be supplied once."
                    mount_mode=ro
                    [[ "$1" != --ssh-mount=* ]] || mount_mode="${1#*=}"
                    [[ "$mount_mode" == ro || "$mount_mode" == rw ]] || die "--ssh-mount accepts ro or rw."
                    shift; continue ;;
                --ssh|--remote-dir)
                    (($# >= 2)) && [[ -n "$2" ]] || die "$1 requires a value."
                    if [[ "$1" == --ssh ]]; then
                        [[ "$saw_ssh" == false ]] || die "--ssh may only be supplied once."
                        ssh_host="$2"; saw_ssh=true
                    else
                        [[ "$saw_dir" == false ]] || die "--remote-dir may only be supplied once."
                        remote_dir="$2"; saw_dir=true
                    fi
                    shift 2; continue ;;
            esac
        fi
        forwarded+=("$1"); shift
    done
    [[ "$saw_dir" == false || "$saw_ssh" == true ]] || die "--remote-dir requires --ssh."
    [[ "$ssh_mcp" == 1 || "$saw_ssh" == true ]] || die "--no-ssh-mcp requires --ssh."
    if [[ -n "$mount_mode" ]]; then
        [[ "$saw_ssh" == true ]] || die "--ssh-mount requires --ssh."
        [[ "$remote_dir" == /* ]] || die "--ssh-mount requires an absolute --remote-dir."
        command -v sshfs >/dev/null || die "--ssh-mount requires sshfs on the host."
        command -v fusermount3 >/dev/null || command -v fusermount >/dev/null || die "--ssh-mount requires fusermount3 or fusermount on the host."
    fi
    local session_interactive=true argument
    interactive_session "${forwarded[@]}" || session_interactive=false
    if [[ -t 0 && -t 1 && "$session_interactive" == true && "$LEGACY_ACCOUNT" == false && "${CX_SESSION_SUPERVISED:-}" != 1 ]]; then
        local -a picker_args=()
        for argument in "${forwarded[@]}"; do
            case "$argument" in --all|--include-non-interactive) ;; *) picker_args+=("$argument") ;; esac
        done
        if ((${#picker_args[@]} == 1)) && [[ "${picker_args[0]}" == resume || "${picker_args[0]}" == --resume ]]; then
            export CX_SESSION_OPEN=1
        fi
        export CX_SESSION_MENU=1 CX_SESSION_SUPERVISED=1 CX_DATA_HOME="$DATA_HOME" CX_AGENT="$AGENT" CX_ACCOUNT="$ACCOUNT" CX_SELECTED_PROFILE="$HOST_CODEX_HOME"
    fi
    if [[ "$saw_ssh" == true ]]; then
        [[ "$ssh_host" != -* ]] || die "Invalid SSH host."
        [[ -z "${CX_SSH_BRIDGE_DIR:-}" ]] || die "Nested SSH bridges are unsupported."
        command -v python3 >/dev/null || die "SSH mode requires Python 3 on the host."
        python3 -c "import tomllib" 2>/dev/null || die "SSH mode requires Python 3.11 or newer."
        command -v ssh >/dev/null || die "SSH mode requires OpenSSH on the host."
        [[ -t 0 && -t 1 ]] || die "SSH mode requires an interactive terminal."
        local slurm_interactive_dir slurm_job_pattern
        slurm_interactive_dir="$(python3 "$CX_ROOT/bin/cx-slurm-setup.py" --lookup "$ssh_host")" || die "Cannot read Slurm configuration for $ssh_host."
        slurm_job_pattern="$(python3 "$CX_ROOT/bin/cx-slurm-setup.py" --lookup-pattern "$ssh_host")" || die "Cannot read Slurm job-ID pattern for $ssh_host."
        local -a ssh_selection=()
        [[ "$LEGACY_ACCOUNT" == true ]] || ssh_selection=(--agent "$AGENT" --account "$ACCOUNT")
        local start_sessions=0
        if [[ "${CX_SESSION_MENU:-}" == 1 ]] && ((${#forwarded[@]} == 0)); then
            start_sessions=1
        fi
        exec env "CX_SSH_START_SESSIONS=$start_sessions" "CX_AGENT=$AGENT" "CX_ACCOUNT=$ACCOUNT" "CX_SELECTED_PROFILE=$HOST_CODEX_HOME" "CX_SSH_MOUNT_REQUEST=${mount_mode}" "CX_SSH_MCP=${ssh_mcp}" "CX_SLURM_INTERACTIVE_DIR=${slurm_interactive_dir}" "CX_SLURM_JOB_ID_PATTERN=${slurm_job_pattern}" python3 "$CX_ROOT/bin/cx-ssh-bridge.py" "$ssh_host" "$remote_dir" \
            "$CX_ROOT/bin/cx" "$workspace" "${ssh_selection[@]}" "${forwarded[@]}"
    fi
    if [[ "${CX_SESSION_MENU:-}" == 1 && -z "${CX_SSH_BRIDGE_DIR:-}" && "${CX_SESSION_CHILD:-}" != 1 ]]; then
        if [[ "$session_interactive" == true ]]; then
            command -v python3 >/dev/null || die "Interactive session menus require Python 3 on the host."
            python3 -c "import tomllib" 2>/dev/null || die "Interactive session menus require Python 3.11 or newer."
            exec env CX_SESSION_CHILD=1 python3 "$CX_ROOT/bin/cx-session-supervisor.py" "$CX_ROOT/bin/cx" "$workspace" --agent "$AGENT" --account "$ACCOUNT" "${forwarded[@]}"
        fi
    fi
    run_container "$workspace" "${forwarded[@]}"
}

main "$@"
